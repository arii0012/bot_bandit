#include <winver.h>

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "BotBandit Project"
      VALUE "FileDescription",  "BotBandit 3D Game and Installer"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "BotBandit_Setup"
      VALUE "LegalCopyright",   "Copyright (C) 2026 BotBandit Project"
      VALUE "OriginalFilename", "BotBandit_Setup.exe"
      VALUE "ProductName",      "BotBandit 3D"
      VALUE "ProductVersion",   "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
